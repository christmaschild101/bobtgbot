# Copy this file to .env and fill in your values.
# BOT_TOKEN is the only required variable.

# Required: bot token from @BotFather
BOT_TOKEN=

# Optional: enables auto-translation of non-English messages (OpenRouter key)
OPENROUTER_API_KEY=
# Optional: OpenRouter model id (defaults to openrouter/free)
OPENROUTER_MODEL=
# Optional: minimum seconds between translations per chat (defaults to 15)
TRANSLATE_COOLDOWN_SECONDS=

# Optional: your Telegram user ID - enables the /broadcast command (owner only)
BOT_OWNER_USER_ID=

# Optional: Whisper model for voice transcription (tiny/base/small/medium/large, defaults to base)
WHISPER_MODEL=